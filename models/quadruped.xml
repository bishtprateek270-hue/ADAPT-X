<mujoco model="adaptx_quadruped">
  <compiler angle="radian" coordinate="local" meshdir="assets"/>
  <option timestep="0.002" iterations="4" solver="Newton" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.5" armature="0.01" frictionloss="0.05"/>
    <geom contype="1" conaffinity="1" condim="3" friction="1.2 0.005 0.0001"/>
    <motor ctrlrange="-18 18" ctrllimited="true"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.1 0.2" width="512" height="512"/>
    <texture name="plane_tex" type="2d" builtin="checker" rgb1="0.2 0.25 0.3" rgb2="0.15 0.18 0.22" width="512" height="512"/>
    <material name="plane_mat" texture="plane_tex" texrepeat="20 20" reflectance="0.1"/>
    <material name="chassis_mat" rgba="0.15 0.17 0.22 1.0" specular="0.5" shininess="0.5"/>
    <material name="leg_mat" rgba="0.75 0.45 0.15 1.0" specular="0.3"/>
    <material name="foot_mat" rgba="0.1 0.1 0.1 1.0" specular="0.1"/>
  </asset>

  <worldbody>
    <!-- Ground Plane -->
    <geom name="floor" type="plane" size="50 50 0.1" material="plane_mat"/>
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1"/>

    <!-- Robot Base Chassis -->
    <body name="torso" pos="0 0 0.35">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.18 0.10 0.04" mass="5.0" material="chassis_mat"/>
      <site name="imu_site" pos="0 0 0"/>

      <!-- ================= FRONT RIGHT LEG ================= -->
      <body name="fr_hip" pos="0.15 -0.09 0">
        <joint name="fr_hip_joint" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="fr_hip_geom" type="capsule" fromto="0 0 0 0 -0.04 0" size="0.02" mass="0.4" material="chassis_mat"/>
        <body name="fr_thigh" pos="0 -0.04 0">
          <joint name="fr_thigh_joint" type="hinge" axis="0 1 0" range="-0.8 1.8"/>
          <geom name="fr_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.018" mass="0.8" material="leg_mat"/>
          <body name="fr_calf" pos="0 0 -0.16">
            <joint name="fr_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.3"/>
            <geom name="fr_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" mass="0.4" material="leg_mat"/>
            <geom name="fr_foot" type="sphere" pos="0 0 -0.16" size="0.02" mass="0.1" material="foot_mat"/>
            <site name="fr_foot_site" pos="0 0 -0.16"/>
          </body>
        </body>
      </body>

      <!-- ================= FRONT LEFT LEG ================= -->
      <body name="fl_hip" pos="0.15 0.09 0">
        <joint name="fl_hip_joint" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="fl_hip_geom" type="capsule" fromto="0 0 0 0 0.04 0" size="0.02" mass="0.4" material="chassis_mat"/>
        <body name="fl_thigh" pos="0 0.04 0">
          <joint name="fl_thigh_joint" type="hinge" axis="0 1 0" range="-0.8 1.8"/>
          <geom name="fl_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.018" mass="0.8" material="leg_mat"/>
          <body name="fl_calf" pos="0 0 -0.16">
            <joint name="fl_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.3"/>
            <geom name="fl_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" mass="0.4" material="leg_mat"/>
            <geom name="fl_foot" type="sphere" pos="0 0 -0.16" size="0.02" mass="0.1" material="foot_mat"/>
            <site name="fl_foot_site" pos="0 0 -0.16"/>
          </body>
        </body>
      </body>

      <!-- ================= REAR RIGHT LEG ================= -->
      <body name="rr_hip" pos="-0.15 -0.09 0">
        <joint name="rr_hip_joint" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="rr_hip_geom" type="capsule" fromto="0 0 0 0 -0.04 0" size="0.02" mass="0.4" material="chassis_mat"/>
        <body name="rr_thigh" pos="0 -0.04 0">
          <joint name="rr_thigh_joint" type="hinge" axis="0 1 0" range="-0.8 1.8"/>
          <geom name="rr_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.018" mass="0.8" material="leg_mat"/>
          <body name="rr_calf" pos="0 0 -0.16">
            <joint name="rr_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.3"/>
            <geom name="rr_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" mass="0.4" material="leg_mat"/>
            <geom name="rr_foot" type="sphere" pos="0 0 -0.16" size="0.02" mass="0.1" material="foot_mat"/>
            <site name="rr_foot_site" pos="0 0 -0.16"/>
          </body>
        </body>
      </body>

      <!-- ================= REAR LEFT LEG ================= -->
      <body name="rl_hip" pos="-0.15 0.09 0">
        <joint name="rl_hip_joint" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <geom name="rl_hip_geom" type="capsule" fromto="0 0 0 0 0.04 0" size="0.02" mass="0.4" material="chassis_mat"/>
        <body name="rl_thigh" pos="0 0.04 0">
          <joint name="rl_thigh_joint" type="hinge" axis="0 1 0" range="-0.8 1.8"/>
          <geom name="rl_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.018" mass="0.8" material="leg_mat"/>
          <body name="rl_calf" pos="0 0 -0.16">
            <joint name="rl_calf_joint" type="hinge" axis="0 1 0" range="-2.6 -0.3"/>
            <geom name="rl_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.16" size="0.014" mass="0.4" material="leg_mat"/>
            <geom name="rl_foot" type="sphere" pos="0 0 -0.16" size="0.02" mass="0.1" material="foot_mat"/>
            <site name="rl_foot_site" pos="0 0 -0.16"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- 12 Direct Motor Actuators controlled via torque or software PD -->
  <actuator>
    <motor name="fr_hip_act" joint="fr_hip_joint"/>
    <motor name="fr_thigh_act" joint="fr_thigh_joint"/>
    <motor name="fr_calf_act" joint="fr_calf_joint"/>

    <motor name="fl_hip_act" joint="fl_hip_joint"/>
    <motor name="fl_thigh_act" joint="fl_thigh_joint"/>
    <motor name="fl_calf_act" joint="fl_calf_joint"/>

    <motor name="rr_hip_act" joint="rr_hip_joint"/>
    <motor name="rr_thigh_act" joint="rr_thigh_joint"/>
    <motor name="rr_calf_act" joint="rr_calf_joint"/>

    <motor name="rl_hip_act" joint="rl_hip_joint"/>
    <motor name="rl_thigh_act" joint="rl_thigh_joint"/>
    <motor name="rl_calf_act" joint="rl_calf_joint"/>
  </actuator>

  <sensor>
    <gyro name="torso_gyro" site="imu_site"/>
    <accelerometer name="torso_accel" site="imu_site"/>
    <touch name="fr_touch" site="fr_foot_site"/>
    <touch name="fl_touch" site="fl_foot_site"/>
    <touch name="rr_touch" site="rr_foot_site"/>
    <touch name="rl_touch" site="rl_foot_site"/>
  </sensor>
</mujoco>
