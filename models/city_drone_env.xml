<mujoco model="adaptx_self_healing_drone_city">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.005" iterations="4" solver="Newton" gravity="0 0 -9.81" density="1.2" viscosity="0.000018"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.48 0.48 0.50" diffuse="0.85 0.85 0.85" specular="0.4 0.4 0.4"/>
  </visual>

  <asset>
    <!-- Vibrant Realistic Sky and City Lighting -->
    <texture type="skybox" builtin="gradient" rgb1="0.32 0.58 0.90" rgb2="0.82 0.92 1.0" width="1024" height="1024"/>

    <!-- High-Resolution Architectural Facade & Ground Textures -->
    <texture name="glass_tower_tex" type="2d" file="textures/facade_glass_tower.png"/>
    <material name="glass_tower_mat" texture="glass_tower_tex" texrepeat="2 4" reflectance="0.45" specular="0.95" shininess="0.9"/>

    <texture name="brick_loft_tex" type="2d" file="textures/facade_brick_loft.png"/>
    <material name="brick_building_mat" texture="brick_loft_tex" texrepeat="2 3" reflectance="0.08" specular="0.15"/>

    <texture name="modern_corporate_tex" type="2d" file="textures/facade_modern_corporate.png"/>
    <material name="corporate_tower_mat" texture="modern_corporate_tex" texrepeat="2 4" reflectance="0.5" specular="0.9" shininess="0.85"/>

    <texture name="concrete_panels_tex" type="2d" file="textures/facade_concrete_panels.png"/>
    <material name="concrete_tower_mat" texture="concrete_panels_tex" texrepeat="2 3" reflectance="0.2" specular="0.4"/>

    <texture name="storefront_tex" type="2d" file="textures/facade_storefront.png"/>
    <material name="storefront_mat" texture="storefront_tex" texrepeat="2 1" reflectance="0.25" specular="0.45"/>

    <texture name="helipad_tex" type="2d" file="textures/helipad.png"/>
    <material name="helipad_mat" texture="helipad_tex" reflectance="0.1" specular="0.2"/>

    <texture name="roof_tar_tex" type="2d" file="textures/roof_tar.png"/>
    <material name="roof_mat" texture="roof_tar_tex" texrepeat="3 3" reflectance="0.05" specular="0.1"/>

    <texture name="plaza_mosaic_tex" type="2d" file="textures/plaza_mosaic.png"/>
    <material name="plaza_mosaic_mat" texture="plaza_mosaic_tex" reflectance="0.15" specular="0.3"/>

    <texture name="sidewalk_pavers_tex" type="2d" file="textures/sidewalk_pavers.png"/>
    <material name="sidewalk_paver_mat" texture="sidewalk_pavers_tex" texrepeat="6 6" reflectance="0.1" specular="0.2"/>

    <!-- Ground & Surface Materials -->
    <texture name="grass_tex" type="2d" builtin="flat" rgb1="0.22 0.52 0.20" width="512" height="512"/>
    <material name="grass_mat" texture="grass_tex" reflectance="0.05" specular="0.1"/>

    <material name="road_mat" rgba="0.13 0.14 0.16 1.0" reflectance="0.12" specular="0.25"/>
    <material name="plaza_granite_mat" rgba="0.75 0.76 0.79 1.0" reflectance="0.15" specular="0.3"/>
    <material name="curb_mat" rgba="0.50 0.52 0.55 1.0"/>
    <material name="road_line_mat" rgba="0.95 0.95 0.95 1.0"/>
    <material name="road_yellow_mat" rgba="0.95 0.78 0.10 1.0"/>

    <!-- Architectural Trim & Mechanical Materials -->
    <material name="metal_spire_mat" rgba="0.88 0.90 0.95 1.0" specular="0.95" shininess="0.95"/>
    <material name="hvac_metal_mat" rgba="0.45 0.48 0.52 1.0" specular="0.6"/>
    <material name="wood_water_tank" rgba="0.55 0.38 0.22 1.0" specular="0.05"/>
    <material name="chimney_brick" rgba="0.62 0.25 0.18 1.0" specular="0.05"/>
    <material name="fountain_water_mat" rgba="0.15 0.55 0.85 0.8" specular="0.95" shininess="0.95" reflectance="0.6"/>

    <!-- Vehicle Materials -->
    <material name="taxi_yellow" rgba="0.98 0.78 0.08 1.0" specular="0.9" shininess="0.8"/>
    <material name="van_blue" rgba="0.12 0.38 0.82 1.0" specular="0.8" shininess="0.7"/>
    <material name="sedan_silver" rgba="0.82 0.84 0.88 1.0" specular="0.95" shininess="0.9"/>
    <material name="car_red" rgba="0.90 0.12 0.12 1.0" specular="0.95" shininess="0.9"/>
    <material name="car_glass" rgba="0.10 0.15 0.22 0.85" specular="0.98" reflectance="0.5"/>
    <material name="tire_rubber" rgba="0.08 0.08 0.09 1.0" specular="0.1"/>

    <!-- Foliage / Trees -->
    <material name="tree_trunk_mat" rgba="0.38 0.24 0.14 1.0" specular="0.05"/>
    <material name="tree_leaf_mat" rgba="0.18 0.62 0.22 1.0" specular="0.1"/>
    <material name="tree_leaf_dark" rgba="0.12 0.46 0.16 1.0" specular="0.1"/>
    <material name="tree_leaf_autumn" rgba="0.82 0.52 0.12 1.0" specular="0.1"/>
    <material name="tree_leaf_cypress" rgba="0.08 0.35 0.14 1.0" specular="0.15"/>

    <!-- Street Furniture & Lights -->
    <material name="street_iron_mat" rgba="0.22 0.23 0.25 1.0" specular="0.6"/>
    <material name="traffic_signal_yellow" rgba="0.95 0.80 0.05 1.0" specular="0.7"/>
    <material name="signal_red_lit" rgba="0.98 0.1 0.1 1.0" emission="1.2"/>
    <material name="signal_green_lit" rgba="0.1 0.98 0.2 1.0" emission="1.2"/>
    <material name="lamp_light_mat" rgba="0.99 0.98 0.85 1.0" emission="1.0"/>
    <material name="aircraft_beacon_mat" rgba="0.99 0.05 0.05 1.0" emission="1.5"/>

    <!-- Drone Materials (Matte Carbon Fiber + Metallic Rotors) -->
    <material name="drone_carbon_mat" rgba="0.08 0.09 0.11 1.0" specular="0.85" shininess="0.9"/>
    <material name="drone_arm_mat" rgba="0.12 0.13 0.15 1.0" specular="0.6" shininess="0.7"/>
    <material name="motor_mat" rgba="0.25 0.26 0.28 1.0" specular="0.95" shininess="0.9"/>
    <material name="motor_gold_mat" rgba="0.85 0.62 0.18 1.0" specular="0.95" shininess="0.9"/>
    <material name="anodized_red" rgba="0.92 0.12 0.12 1.0" specular="0.95" shininess="0.95"/>
    <material name="rotor_front_mat" rgba="0.92 0.18 0.14 0.75" specular="0.85"/>
    <material name="rotor_rear_mat" rgba="0.18 0.20 0.24 0.75" specular="0.85"/>
    <material name="prop_hub_mat" rgba="0.95 0.95 0.98 1.0" specular="0.95"/>
    <material name="battery_mat" rgba="0.16 0.17 0.19 1.0" specular="0.2"/>
    <material name="battery_label_mat" rgba="0.95 0.75 0.05 1.0"/>
    <material name="camera_gimbal_mat" rgba="0.20 0.21 0.24 1.0" specular="0.7"/>
    <material name="camera_lens_mat" rgba="0.08 0.25 0.65 1.0" specular="0.98" reflectance="0.6"/>
    <material name="led_green" rgba="0.05 0.98 0.2 1.0" emission="1.0"/>
    <material name="led_red" rgba="0.98 0.05 0.05 1.0" emission="1.0"/>
    <material name="led_blue" rgba="0.1 0.5 0.98 1.0" emission="1.0"/>
    <material name="led_white" rgba="0.98 0.98 0.98 1.0" emission="1.0"/>
  </asset>

  <worldbody>
    <!-- Sunlight and Ambient Lighting -->
    <light directional="true" diffuse="0.95 0.95 0.90" specular="0.4 0.4 0.4" pos="20 -20 35" dir="-0.3 0.3 -1"/>
    <light directional="false" diffuse="0.48 0.48 0.55" pos="0 0 20"/>

    <!-- Cinematic City Cameras -->
    <camera name="city_birds_eye" pos="-24 -24 22" xyaxes="0.707 -0.707 0 0.38 0.38 0.84"/>
    <camera name="plaza_view" pos="0 -18 3.5" xyaxes="1 0 0 0 0.15 0.98"/>

    <!-- Ground: Surrounding Parkland -->
    <geom name="ground" type="plane" size="80 80 0.1" material="grass_mat"/>

    <!-- Grand Central Plaza with Decorative Star Mosaic -->
    <geom name="grand_plaza_border" type="plane" pos="0 0 0.001" size="8.2 8.2 0.01" material="plaza_granite_mat"/>
    <geom name="grand_plaza_mosaic" type="plane" pos="0 0 0.002" size="6.5 6.5 0.01" material="plaza_mosaic_mat"/>

    <!-- Central Plaza Fountain & Granite Obelisk -->
    <body name="plaza_fountain" pos="0 0 0">
      <geom type="cylinder" pos="0 0 0.25" size="1.6 0.25" material="plaza_granite_mat"/>
      <geom type="cylinder" pos="0 0 0.48" size="1.45 0.02" material="fountain_water_mat"/>
      <geom type="box" pos="0 0 0.75" size="0.45 0.45 0.25" material="plaza_granite_mat"/>
      <geom type="cylinder" pos="0 0 1.5" size="0.18 0.5" material="plaza_granite_mat"/>
      <geom type="cylinder" pos="0 0 2.2" size="0.08 0.3" material="metal_spire_mat"/>
    </body>

    <!-- Broad Asphalt Boulevards (14m wide avenues) -->
    <geom name="boulevard_ns" type="plane" pos="0 0 0.003" size="6.0 75 0.01" material="road_mat"/>
    <geom name="boulevard_ew" type="plane" pos="0 0 0.004" size="75 6.0 0.01" material="road_mat"/>

    <!-- Paved Sidewalk Curbs with Real Stone Tiles -->
    <geom name="sidewalk_nw" type="box" pos="-12.5 12.5 0.08" size="6.0 6.0 0.08" material="sidewalk_paver_mat"/>
    <geom name="sidewalk_ne" type="box" pos="12.5 12.5 0.08" size="6.0 6.0 0.08" material="sidewalk_paver_mat"/>
    <geom name="sidewalk_sw" type="box" pos="-12.5 -12.5 0.08" size="6.0 6.0 0.08" material="sidewalk_paver_mat"/>
    <geom name="sidewalk_se" type="box" pos="12.5 -12.5 0.08" size="6.0 6.0 0.08" material="sidewalk_paver_mat"/>

    <!-- Road Dividing Lines & Center Double Yellows -->
    <geom name="line_n1" type="box" pos="0 15 0.006" size="0.08 5.0 0.001" material="road_yellow_mat"/>
    <geom name="line_n2" type="box" pos="0 27 0.006" size="0.08 5.0 0.001" material="road_yellow_mat"/>
    <geom name="line_s1" type="box" pos="0 -15 0.006" size="0.08 5.0 0.001" material="road_yellow_mat"/>
    <geom name="line_s2" type="box" pos="0 -27 0.006" size="0.08 5.0 0.001" material="road_yellow_mat"/>
    <geom name="line_e1" type="box" pos="15 0 0.006" size="5.0 0.08 0.001" material="road_yellow_mat"/>
    <geom name="line_e2" type="box" pos="27 0 0.006" size="5.0 0.08 0.001" material="road_yellow_mat"/>
    <geom name="line_w1" type="box" pos="-15 0 0.006" size="5.0 0.08 0.001" material="road_yellow_mat"/>
    <geom name="line_w2" type="box" pos="-27 0 0.006" size="5.0 0.08 0.001" material="road_yellow_mat"/>

    <!-- Pedestrian Crosswalk Stripes (Zebra Crossings) -->
    <geom name="zebra_n1" type="box" pos="-3.5 7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>
    <geom name="zebra_n2" type="box" pos="-1.2 7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>
    <geom name="zebra_n3" type="box" pos="1.2 7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>
    <geom name="zebra_n4" type="box" pos="3.5 7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>

    <geom name="zebra_s1" type="box" pos="-3.5 -7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>
    <geom name="zebra_s2" type="box" pos="-1.2 -7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>
    <geom name="zebra_s3" type="box" pos="1.2 -7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>
    <geom name="zebra_s4" type="box" pos="3.5 -7.5 0.006" size="0.45 0.65 0.001" material="road_line_mat"/>

    <!-- ================================================================= -->
    <!-- 3D REAL-WORLD ARCHITECTURAL BUILDINGS (ALL HIGHLY UNIQUE & DETAILED) -->
    <!-- ================================================================= -->

    <!-- BUILDING 1: THE GRAND HORIZON SKYSCRAPER (North-East, pos=16 16) -->
    <!-- Stepped 3-tier blue glass curtain-wall tower with rooftop helipad and spire -->
    <body name="tower_ne" pos="16 16 0">
      <!-- Ground Level Retail & Lobby Atrium -->
      <geom type="box" pos="0 0 2.5" size="4.8 4.8 2.5" material="storefront_mat"/>
      <!-- Tier 1: Lower Office Tower (Z: 5 to 13m) -->
      <geom type="box" pos="0 0 9.0" size="4.4 4.4 4.0" material="glass_tower_mat"/>
      <!-- Tier 2: Upper Executive Tower with Setback (Z: 13 to 19m) -->
      <geom type="box" pos="0 0 16.0" size="3.6 3.6 3.0" material="glass_tower_mat"/>
      <!-- Tier 3: Penthouse Crown (Z: 19 to 22m) -->
      <geom type="box" pos="0 0 20.5" size="2.8 2.8 1.5" material="glass_tower_mat"/>
      <!-- Rooftop Official Helipad -->
      <geom type="box" pos="0 0 22.05" size="2.6 2.6 0.05" material="helipad_mat"/>
      <!-- Rooftop Architectural Spire with Flashing Red Beacon LED -->
      <geom type="cylinder" pos="0 0 24.5" size="0.08 2.5" material="metal_spire_mat"/>
      <geom type="sphere" pos="0 0 27.0" size="0.12" material="aircraft_beacon_mat"/>
    </body>

    <!-- BUILDING 2: OLD METROPOLITAN BRICK LOFTS (North-West, pos=-16 16) -->
    <!-- Heritage 5-story brownstone masonry with retail arcade & rooftop water tank -->
    <body name="tower_nw" pos="-16 16 0">
      <!-- Ground Retail Arcade with Awnings -->
      <geom type="box" pos="0 0 2.2" size="4.6 4.8 2.2" material="storefront_mat"/>
      <!-- Heritage Red Brick Residential Body (Z: 4.4 to 12.4m) -->
      <geom type="box" pos="0 0 8.4" size="4.4 4.6 4.0" material="brick_building_mat"/>
      <!-- Stepped Brick Cornice & Parapet -->
      <geom type="box" pos="0 0 12.8" size="4.5 4.7 0.4" material="chimney_brick"/>
      <geom type="box" pos="0 0 13.05" size="4.2 4.4 0.05" material="roof_mat"/>
      <!-- Authentic NYC Cedar Water Tower on Steel Stilts -->
      <body name="water_tower" pos="1.5 -1.5 13.1">
        <geom type="cylinder" pos="-0.8 -0.8 0.6" size="0.04 0.6" material="street_iron_mat"/>
        <geom type="cylinder" pos="0.8 -0.8 0.6" size="0.04 0.6" material="street_iron_mat"/>
        <geom type="cylinder" pos="-0.8 0.8 0.6" size="0.04 0.6" material="street_iron_mat"/>
        <geom type="cylinder" pos="0.8 0.8 0.6" size="0.04 0.6" material="street_iron_mat"/>
        <!-- Cedar Barrel -->
        <geom type="cylinder" pos="0 0 1.9" size="0.95 0.7" material="wood_water_tank"/>
        <!-- Conical Cap -->
        <geom type="cylinder" pos="0 0 2.8" size="0.9 0.2" material="roof_mat"/>
      </body>
      <!-- Industrial Red Brick Chimney Stack -->
      <geom type="box" pos="-2.2 2.2 14.5" size="0.35 0.35 1.5" material="chimney_brick"/>
    </body>

    <!-- BUILDING 3: APEX CORPORATE FINANCIAL CENTER (South-West, pos=-16 -16) -->
    <!-- Dual-tier obsidian black glass & champagne bronze tower with rooftop HVAC chillers -->
    <body name="tower_sw" pos="-16 -16 0">
      <!-- Ground Entrance Pavilion -->
      <geom type="box" pos="0 0 2.2" size="4.8 4.2 2.2" material="corporate_tower_mat"/>
      <!-- Main Corporate Tower (Z: 4.4 to 15.4m) -->
      <geom type="box" pos="0 0 9.9" size="4.4 3.8 5.5" material="corporate_tower_mat"/>
      <!-- Architectural Setback Crown (Z: 15.4 to 18.4m) -->
      <geom type="box" pos="0 0 16.9" size="3.4 3.0 1.5" material="corporate_tower_mat"/>
      <geom type="box" pos="0 0 18.45" size="3.2 2.8 0.05" material="roof_mat"/>
      <!-- Rooftop Mechanical HVAC Chillers & Satellite Uplink -->
      <geom type="box" pos="0.8 0.6 19.2" size="0.8 0.6 0.7" material="hvac_metal_mat"/>
      <geom type="box" pos="-0.8 0.6 19.2" size="0.8 0.6 0.7" material="hvac_metal_mat"/>
      <geom type="cylinder" pos="0 -0.8 19.5" size="0.05 1.0" material="metal_spire_mat"/>
      <geom type="sphere" pos="0 -0.8 20.4" size="0.4" material="metal_spire_mat"/>
    </body>

    <!-- BUILDING 4: VANGUARD RESIDENCES & SKY-GARDEN (South-East, pos=16 -16) -->
    <!-- Contemporary white architectural precast concrete high-rise with rooftop terrace -->
    <body name="tower_se" pos="16 -16 0">
      <!-- Ground Level Lobby -->
      <geom type="box" pos="0 0 2.2" size="4.4 4.4 2.2" material="storefront_mat"/>
      <!-- Residential Tower with Ribbon Windows (Z: 4.4 to 14.4m) -->
      <geom type="box" pos="0 0 9.4" size="4.0 4.0 5.0" material="concrete_tower_mat"/>
      <!-- Stepped Penthouse Level (Z: 14.4 to 17.4m) -->
      <geom type="box" pos="-0.5 0.5 15.9" size="3.0 3.0 1.5" material="concrete_tower_mat"/>
      <!-- Sky Terrace Lawn & Pergola -->
      <geom type="box" pos="1.4 -1.4 14.45" size="1.2 1.2 0.05" material="grass_mat"/>
      <!-- Rooftop Elevator Machine Room -->
      <geom type="box" pos="-1.0 1.0 17.9" size="1.0 1.0 0.5" material="roof_mat"/>
      <geom type="cylinder" pos="-1.0 1.0 19.2" size="0.06 0.8" material="metal_spire_mat"/>
    </body>

    <!-- ================================================================= -->
    <!-- URBAN INFILL BLOCKS (ALONG THE AVENUES CREATING REAL STREET CANYONS) -->
    <!-- ================================================================= -->
    <!-- North Avenue Commercial Mid-Rise (pos=0 30) -->
    <body name="block_north" pos="0 30 0">
      <geom type="box" pos="0 0 6.5" size="8.5 4.0 6.5" material="concrete_tower_mat"/>
      <geom type="box" pos="0 0 13.05" size="8.2 3.8 0.05" material="roof_mat"/>
      <geom type="box" pos="2.0 0 13.7" size="1.2 1.0 0.6" material="hvac_metal_mat"/>
    </body>

    <!-- South Avenue High-Tech Campus (pos=0 -30) -->
    <body name="block_south" pos="0 -30 0">
      <geom type="box" pos="0 0 8.0" size="8.0 4.2 8.0" material="corporate_tower_mat"/>
      <geom type="box" pos="0 0 16.05" size="7.6 3.8 0.05" material="roof_mat"/>
    </body>

    <!-- East Boulevard Grand Hotel (pos=30 0) -->
    <body name="block_east" pos="30 0 0">
      <geom type="box" pos="0 0 7.0" size="4.2 8.5 7.0" material="brick_building_mat"/>
      <geom type="box" pos="0 0 14.05" size="3.8 8.0 0.05" material="roof_mat"/>
    </body>

    <!-- West Boulevard Financial Center (pos=-30 0) -->
    <body name="block_west" pos="-30 0 0">
      <geom type="box" pos="0 0 7.5" size="4.0 8.0 7.5" material="glass_tower_mat"/>
      <geom type="box" pos="0 0 15.05" size="3.6 7.6 0.05" material="roof_mat"/>
    </body>

    <!-- Distant Perimeter Skyline Skyscrapers (Depth Illusion at Horizon) -->
    <geom type="box" pos="38 38 14.0" size="7.0 7.0 14.0" material="glass_tower_mat"/>
    <geom type="box" pos="-38 38 15.0" size="6.5 7.5 15.0" material="corporate_tower_mat"/>
    <geom type="box" pos="-38 -38 13.5" size="7.5 6.5 13.5" material="concrete_tower_mat"/>
    <geom type="box" pos="38 -38 16.0" size="7.0 7.0 16.0" material="glass_tower_mat"/>

    <!-- ================================================================= -->
    <!-- STREET-LEVEL CITY LIFE: PARKED CARS, LIGHTS, BUS STOPS & TREES -->
    <!-- ================================================================= -->

    <!-- Parked Vehicle 1: Yellow City Taxi Cab (pos=5.0 7.2) -->
    <body name="taxi_cab" pos="5.0 7.2 0">
      <!-- Chassis -->
      <geom type="box" pos="0 0 0.30" size="1.7 0.75 0.18" material="taxi_yellow"/>
      <!-- Cabin Glass & Roof -->
      <geom type="box" pos="-0.1 0 0.54" size="0.95 0.68 0.16" material="car_glass"/>
      <geom type="box" pos="-0.1 0 0.68" size="0.92 0.65 0.03" material="taxi_yellow"/>
      <!-- Taxi Rooftop Sign -->
      <geom type="box" pos="-0.1 0 0.74" size="0.25 0.12 0.04" material="taxi_yellow"/>
      <!-- Wheels -->
      <geom type="cylinder" pos="1.0 0.78 0.22" size="0.22 0.08" zaxis="0 1 0" material="tire_rubber"/>
      <geom type="cylinder" pos="-1.0 0.78 0.22" size="0.22 0.08" zaxis="0 1 0" material="tire_rubber"/>
      <geom type="cylinder" pos="1.0 -0.78 0.22" size="0.22 0.08" zaxis="0 1 0" material="tire_rubber"/>
      <geom type="cylinder" pos="-1.0 -0.78 0.22" size="0.22 0.08" zaxis="0 1 0" material="tire_rubber"/>
    </body>

    <!-- Parked Vehicle 2: Navy Blue Delivery Van (pos=-5.0 -12.0) -->
    <body name="delivery_van" pos="-5.0 -12.0 0">
      <geom type="box" pos="0 0 0.55" size="2.2 0.88 0.45" material="van_blue"/>
      <geom type="box" pos="1.3 0 0.50" size="0.65 0.84 0.35" material="car_glass"/>
      <geom type="cylinder" pos="1.4 0.90 0.25" size="0.25 0.10" zaxis="0 1 0" material="tire_rubber"/>
      <geom type="cylinder" pos="-1.3 0.90 0.25" size="0.25 0.10" zaxis="0 1 0" material="tire_rubber"/>
      <geom type="cylinder" pos="1.4 -0.90 0.25" size="0.25 0.10" zaxis="0 1 0" material="tire_rubber"/>
      <geom type="cylinder" pos="-1.3 -0.90 0.25" size="0.25 0.10" zaxis="0 1 0" material="tire_rubber"/>
    </body>

    <!-- Parked Vehicle 3: Executive Silver Sedan (pos=12.0 -5.0) -->
    <body name="silver_sedan" pos="12.0 -5.0 0">
      <geom type="box" pos="0 0 0.30" size="0.75 1.8 0.18" material="sedan_silver"/>
      <geom type="box" pos="0 -0.1 0.54" size="0.68 1.0 0.16" material="car_glass"/>
